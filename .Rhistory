source("~/Downloads/setup_dslite_5servers_c1.R")
# Create a list to hold the 5 separate servers
dslite_servers <- list()
for (k in 1:K) {
# Create a NEW DSLite server for this study
dslite_servers[[k]] <- newDSLiteServer(
tables = list(
study_data = data_list[[k]]  # Each server has only its own study data
)
)
# Configure this server with DataSHIELD methods
dslite_servers[[k]]$config(defaultDSConfiguration(include = c("dsBase", "dsRctFed")))
dslite.server$aggregateMethod("localAteDS", "localAteDS")
cat(sprintf("Server %d created: %d observations\n", k, nrow(data_list[[k]])))
}
