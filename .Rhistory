# Example input: a comma-separated string of covariate names
covariate_names_str <- "age, sex, bmi, smoking_status"
# --- Your original approach ---
covariate_names <- trimws(unlist(strsplit(covariate_names_str, split = ",", fixed = TRUE)))
cat("Result:\n")
print(covariate_names)
cat("Class:", class(covariate_names), "\n")
cat("Length:", length(covariate_names), "\n")
# --- Practical use: subset a data frame ---
df <- data.frame(
id             = 1:5,
age            = c(25, 34, 45, 52, 61),
sex            = c("F", "M", "F", "M", "F"),
bmi            = c(22.1, 27.3, 30.5, 24.8, 26.0),
smoking_status = c("never", "former", "current", "never", "former"),
income         = c(40000, 55000, 60000, 48000, 72000)
)
cat("\nFull data frame:\n")
print(df)
cat("\nSubset using parsed covariate names:\n")
print(df[, covariate_names])
# Example input
covariate_names_str <- "age, sex, bmi, smoking_status"
# --- Approach 1: strsplit + unlist + trimws ---
cov1 <- trimws(unlist(strsplit(covariate_names_str, split = ",", fixed = TRUE)))
# --- Approach 2: scan ---
cov2 <- scan(text = covariate_names_str, what = "", sep = ",", strip.white = TRUE, quiet = TRUE)
# Compare results
cat("Approach 1 (strsplit):\n")
print(cov1)
cat("\nApproach 2 (scan):\n")
print(cov2)
cat("\nIdentical?", identical(cov1, cov2), "\n")
# --- Practical use: subset a data frame ---
